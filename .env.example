TELEGRAM_BOT_TOKEN=put_your_telegram_bot_token_here
DATABASE_URL=postgresql://user:password@host:5432/dbname
OPENAI_API_KEY=put_your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_AUDIO_MODEL=whisper-1
APP_URL=https://your-public-url.example.com
NOTION_TOKEN=put_your_notion_integration_token_here
NOTION_PARENT_PAGE_ID=put_your_notion_parent_page_id_here
NOTION_TASKS_DATA_SOURCE_ID=put_your_notion_tasks_data_source_id_here
NOTION_VERSION=2022-06-28
MORNING_BRIEF_ENABLED=true
MORNING_BRIEF_TIMEZONE=Asia/Almaty
MORNING_BRIEF_HOUR=10
MORNING_BRIEF_MINUTE=0
EVENING_RETRO_ENABLED=true
EVENING_RETRO_TIMEZONE=Asia/Almaty
EVENING_RETRO_HOUR=21
EVENING_RETRO_MINUTE=0
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_BACKEND=chromadb
AGENT_MEMORY_PATH=.chroma
AGENT_MEMORY_COLLECTION=agent_memory

# Security: comma-separated Telegram chat IDs that are allowed to use the bot.
# Leave empty to allow all chats (development). Set in production!
# ALLOWED_CHAT_IDS=123456789

# Per-chat rate limit (messages per minute). 0 = disabled.
RATE_LIMIT_PER_MINUTE=20

# Optional: path to a JSON file overriding the built-in task aliases.
# Format: {"alias_key": ["needle1", "needle2"], ...}
# TASK_ALIASES_FILE=task_aliases.json
